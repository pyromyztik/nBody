# Frontend Environment Configuration Template
# Duplicate this file to .env.local or .env.production and fill in your actual infrastructure endpoints.

# Dedicated EC2 uWebSockets TLS endpoint (or ws://localhost:8080/frames for local dev)
VITE_WS_URL=wss://<your-ec2-ip-or-domain>/frames

# Serverless AWS Lambda Wake-on-demand Function URL
VITE_WAKE_URL=https://<your-lambda-url-id>.lambda-url.<region>.on.aws/

# Base path for GitHub Pages (defaults to /<repo-name>/ in production, / in dev)
VITE_BASE_PATH=/nBody/
