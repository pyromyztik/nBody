[Unit]
Description=N-Body Simulation C++ Backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/nBody
ExecStart=/home/ubuntu/nBody/scripts/run_server.sh
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=15s
EnvironmentFile=-/etc/default/nbody
RuntimeDirectory=nbody
RuntimeDirectoryMode=0755
Environment=SIM_ACTIVITY_FILE=/run/nbody/nbody_sim_active

[Install]
WantedBy=multi-user.target
